{
  "name": "funds-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Local governed Funds Manager dashboard backed by YvY source data, MySQL, PHP, and reproducible quality controls.",
  "scripts": {
    "generate": "py -3.12 \"Sprint 2/src/pipeline/run_pipeline.py\"",
    "validate:sprint3": "py -3.12 \"Sprint 2/src/pipeline/run_sprint3.py\" --input \"Sprint 2/tests/fixtures/sprint3_source\" --dry-run",
    "build": "node \"Sprint 2/scripts/build_release.mjs\" && npm run lint:web && npm run lint:php",
    "start": "node \"Sprint 2/scripts/start_local.mjs\"",
    "database:migrate": "node \"Sprint 2/scripts/php_cli.mjs\" migrate",
    "release:package": "py -3.12 \"Sprint 2/scripts/package_release.py\"",
    "auth:provision": "node \"Sprint 2/scripts/php_cli.mjs\" provision",
    "test:auth": "node \"Sprint 2/tests/api/auth.mjs\"",
    "test:accounts": "node \"Sprint 2/tests/api/account_lifecycle.mjs\"",
    "test:performance": "node \"Sprint 2/tests/api/performance.mjs\"",
    "database:seed": "py -3.12 \"Sprint 2/database/build_seed.py\"",
    "database:setup": "powershell -ExecutionPolicy Bypass -File \"Sprint 2/scripts/setup_database.ps1\"",
    "test:python": "py -3.12 -m unittest discover -s \"Sprint 2/tests\" -p \"test_*.py\"",
    "test:api": "node \"Sprint 2/tests/api/integration.mjs\"",
    "test:business": "node \"Sprint 2/tests/api/business_logic.mjs\"",
    "test:web": "node \"Sprint 2/tests/web/smoke.mjs\"",
    "test:search": "node \"Sprint 2/tests/web/quality_search_race.mjs\"",
    "test": "npm run build && npm run test:python && npm run test:business && npm run test:api && npm run test:web && npm run test:auth && npm run test:accounts && npm run test:search && npm run test:performance",
    "lint:python": "py -3.12 -m compileall -q \"Sprint 2/src/pipeline\" \"Sprint 2/database\" \"Sprint 2/scripts\" \"Sprint 2/tests\"",
    "lint:web": "node \"Sprint 2/tests/lint_javascript.mjs\"",
    "lint:php": "node \"Sprint 2/tests/api/lint_php.mjs\"",
    "lint": "npm run lint:python && npm run lint:web && npm run lint:php"
  },
  "devDependencies": {
    "playwright": "^1.52.0"
  }
}
