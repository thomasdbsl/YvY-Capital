{
  "name": "funds-manager-sprint2-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only synthetic Sprint 2 prototype and verification suite.",
  "scripts": {
    "generate": "py -3.12 \"Sprint 2/pipeline/run_pipeline.py\"",
    "start": "py -3.12 -m http.server 4173 --directory \"Sprint 2\"",
    "test:python": "py -3.12 -m unittest discover -s \"Sprint 2/tests\" -p \"test_*.py\"",
    "test:web": "node \"Sprint 2/tests/web/smoke.mjs\"",
    "test": "npm run test:python && npm run test:web"
  },
  "devDependencies": {
    "playwright": "^1.52.0"
  }
}
