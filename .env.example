# Copy these values into the current terminal or an ignored local configuration.
# local | test | production. Production rejects root DB user, placeholder passwords,
# debug mode, non-secure cookies and non-HTTPS allowed origins.
FUNDS_MANAGER_ENV=local
FUNDS_MANAGER_DB_HOST=127.0.0.1
FUNDS_MANAGER_DB_PORT=3306
FUNDS_MANAGER_DB_NAME=yvy_funds_manager
FUNDS_MANAGER_DB_USER=root
FUNDS_MANAGER_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY
MAMP_MYSQL_EXECUTABLE=C:\MAMP\bin\mysql\bin\mysql.exe
FUNDS_MANAGER_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
FUNDS_MANAGER_DEBUG=0
FUNDS_MANAGER_SESSION_TIMEOUT=1800
FUNDS_MANAGER_SECURE_COOKIE=0
# Optional overrides: PHP_EXECUTABLE, PHP_INI, FUNDS_MANAGER_HTTP_PORT,
# FUNDS_MANAGER_LOCK_DIR (shared by all local import processes), FUNDS_MANAGER_MYSQLDUMP.
# Peer integration remains gated by certification, not an environment toggle.
# Beta modelling parameter pending partner validation (2-252 daily returns).
FUNDS_MANAGER_MIN_RISK_OBSERVATIONS=20
